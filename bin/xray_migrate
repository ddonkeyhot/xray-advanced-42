#!/bin/bash
set -u

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

CONFIG_FILE="/usr/local/etc/xray/config.json"

if [[ ! -f "$CONFIG_FILE" ]]; then
    exit 0
fi

# 1. WARP MTU & Reserved bytes migration
HAS_WARP=$(jq -e '.outbounds[] | select(.tag == "warp")' "$CONFIG_FILE" >/dev/null 2>&1 && echo "true" || echo "false")
NEEDS_MIGRATE="false"

if [[ "$HAS_WARP" == "true" ]]; then
    if jq -e '.outbounds[] | select(.tag == "warp" and .settings.mtu == null)' "$CONFIG_FILE" >/dev/null 2>&1; then
        NEEDS_MIGRATE="true"
        echo -e "${BLUE}▶ Миграция: Обнаружена старая конфигурация WARP (без MTU и reserved).${NC}"
    fi
else
    NEEDS_MIGRATE="true"
    echo -e "${BLUE}▶ Миграция: Восстановление отсутствующего исходящего канала WARP.${NC}"
fi

if [[ "$NEEDS_MIGRATE" == "true" ]]; then
    echo -e "   Запрашиваем новые данные у Cloudflare..."

    if ! command -v wg >/dev/null 2>&1; then
        apt-get update >/dev/null 2>&1 && apt-get install -y wireguard-tools >/dev/null 2>&1
    fi

    WARP_LOCAL_PRIV=$(wg genkey)
    WARP_LOCAL_PUB=$(echo "$WARP_LOCAL_PRIV" | wg pubkey)
    
    WARP_RESP=""
    for i in {1..3}; do
        WARP_RESP=$(curl -s -m 10 -X POST "https://api.cloudflareclient.com/v0a1922/reg" \
            -H "User-Agent: okhttp/3.12.1" \
            -H "Content-Type: application/json; charset=UTF-8" \
            -d "{\"key\":\"${WARP_LOCAL_PUB}\",\"install_id\":\"\",\"fcm_token\":\"\",\"tos\":\"$(date -u +%Y-%m-%dT%H:%M:%S.000Z)\",\"model\":\"PC\",\"serial_number\":\"\",\"locale\":\"en_US\"}" || true)
        
        if echo "$WARP_RESP" | jq -e '.id' >/dev/null 2>&1; then
            break
        fi
        sleep 3
    done

    if echo "$WARP_RESP" | jq -e '.id' >/dev/null 2>&1; then
        WARP_PRIVATE_KEY="$WARP_LOCAL_PRIV"
        WARP_IPV4=$(echo "$WARP_RESP" | jq -r '.config.interface.addresses.v4')
        WARP_IPV6=$(echo "$WARP_RESP" | jq -r '.config.interface.addresses.v6')
        WARP_CLIENT_ID=$(echo "$WARP_RESP" | jq -r ".config.client_id // \"\"")
        
        WARP_RESERVED="[0,0,0]"
        if [[ -n "$WARP_CLIENT_ID" ]]; then
            RESERVED_BYTES=$(echo -n "$WARP_CLIENT_ID" | base64 -d | od -An -t u1 | tr -d "\n" | tr -s " " | sed "s/^ //; s/ /,/g" | sed "s/,$//")
            WARP_RESERVED="[$RESERVED_BYTES]"
        fi

        TMP_CFG=$(mktemp --suffix=.json)
        WARP_OBJ=$(jq -n \
           --arg priv "$WARP_PRIVATE_KEY" \
           --arg pub "bmXOC+F1FxEMF9dyiK2H5/1SUtzHZsVoW++ZKgukR2g=" \
           --arg ip4 "$WARP_IPV4/32" \
           --arg ip6 "$WARP_IPV6/128" \
           --argjson reserved "$WARP_RESERVED" \
           '{
              protocol: "wireguard",
              tag: "warp",
              settings: {
                secretKey: $priv,
                address: (if $ip6 == "null/128" or $ip6 == "/128" then [$ip4] else [$ip4, $ip6] end),
                peers: [
                  {
                    publicKey: $pub,
                    endpoint: "162.159.192.1:2408",
                    keepAlive: 25,
                    reserved: $reserved
                  }
                ],
                mtu: 1280
              }
           }')
           
        if [[ "$HAS_WARP" == "true" ]]; then
            jq --argjson warp "$WARP_OBJ" '(.outbounds[] | select(.tag == "warp")) = $warp' "$CONFIG_FILE" > "$TMP_CFG"
        else
            jq --argjson warp "$WARP_OBJ" '.outbounds += [$warp]' "$CONFIG_FILE" > "$TMP_CFG"
        fi

        if /usr/local/bin/xray -test -config "$TMP_CFG" >/dev/null 2>&1; then
            mv "$TMP_CFG" "$CONFIG_FILE" && chmod 644 "$CONFIG_FILE"
            systemctl restart xray
            echo -e "${GREEN}✓ Миграция WARP успешно завершена. Служба Xray перезапущена.${NC}"
            sleep 2
        else
            echo -e "${RED}[ОШИБКА] Неверная конфигурация после миграции. Откат изменений.${NC}"
            rm -f "$TMP_CFG"
            sleep 2
        fi
    else
        echo -e "${YELLOW}[!] Ошибка API Cloudflare при миграции WARP. Попробуйте позже.${NC}"
        sleep 2
    fi
fi
