#!/bin/bash
set -u

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

LOG_FILE="/var/log/xray-advanced-42/health.log"
CONFIG_FILE="/usr/local/etc/xray/config.json"
XRAY_BIN="/usr/local/bin/xray"

echo -e "${CYAN}================================================================${NC}"
echo -e "${CYAN}            ОБНОВЛЕНИЕ БАЗ GEOIP / GEOSITE (Loyalsoldier)       ${NC}"
echo -e "${CYAN}================================================================${NC}"

TMP_DIR=$(mktemp -d)
trap 'rm -rf "$TMP_DIR"' EXIT

echo -e "${BLUE}▶ 1/4 Скачивание последних версий баз...${NC}"
if ! curl -fsSL --connect-timeout 10 https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geoip.dat -o "$TMP_DIR/geoip.dat"; then
    echo -e "${RED}[ОШИБКА] Не удалось скачать geoip.dat${NC}"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [ERROR] [GEOIP] Ошибка скачивания geoip.dat" >> "$LOG_FILE"
    exit 1
fi
if ! curl -fsSL --connect-timeout 10 https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geosite.dat -o "$TMP_DIR/geosite.dat"; then
    echo -e "${RED}[ОШИБКА] Не удалось скачать geosite.dat${NC}"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [ERROR] [GEOIP] Ошибка скачивания geosite.dat" >> "$LOG_FILE"
    exit 1
fi

echo -e "${BLUE}▶ 2/4 Проверка целостности файлов...${NC}"
SIZE_GEOIP=$(wc -c < "$TMP_DIR/geoip.dat")
SIZE_GEOSITE=$(wc -c < "$TMP_DIR/geosite.dat")
if (( SIZE_GEOIP < 1000000 || SIZE_GEOSITE < 1000000 )); then
    echo -e "${RED}[ОШИБКА] Скачанные файлы слишком малы (возможно, ошибка скачивания). Отмена.${NC}"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [ERROR] [GEOIP] Файлы баз слишком малы" >> "$LOG_FILE"
    exit 1
fi

echo -e "${BLUE}▶ 3/4 Симуляция запуска Xray с новыми базами...${NC}"
mkdir -p "$TMP_DIR/share/xray"
cp "$TMP_DIR/geoip.dat" "$TMP_DIR/share/xray/"
cp "$TMP_DIR/geosite.dat" "$TMP_DIR/share/xray/"
export XRAY_LOCATION_ASSET="$TMP_DIR/share/xray"

TEST_OUT=$(timeout 5 $XRAY_BIN -test -config "$CONFIG_FILE" 2>&1 || true)
if ! echo "$TEST_OUT" | grep -q "Configuration OK"; then
    echo -e "${RED}[ОШИБКА] Xray не смог запуститься с новыми базами! Откат обновления.${NC}"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [ERROR] [GEOIP] Xray не прошел тест с новыми базами" >> "$LOG_FILE"
    exit 1
fi

echo -e "${BLUE}▶ 4/4 Атомарная замена и перезапуск Xray...${NC}"
mv "$TMP_DIR/share/xray/geoip.dat" /usr/local/share/xray/geoip.dat
mv "$TMP_DIR/share/xray/geosite.dat" /usr/local/share/xray/geosite.dat
systemctl restart xray

echo -e "${GREEN}✓ Базы GeoIP и GeoSite успешно обновлены!${NC}"
echo "[$(date '+%Y-%m-%d %H:%M:%S')] [INFO] [GEOIP] Базы Loyalsoldier успешно обновлены" >> "$LOG_FILE"
