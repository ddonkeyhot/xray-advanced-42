#!/bin/bash
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

CONFIG_FILE="/usr/local/etc/xray/config.json"
REALITY_ENV="/usr/local/etc/xray/reality.env"
SNI_FILE="/usr/local/etc/xray/sni_pool.txt"
LOG_FILE="/var/log/xray-advanced-42/health.log"

if [[ ! -f "$CONFIG_FILE" || ! -f "$REALITY_ENV" ]]; then
    echo -e "${RED}[ОШИБКА] Xray не установлен или поврежден конфигурационный файл.${NC}"
    exit 1
fi

source "$REALITY_ENV"

if [[ ! -f "$SNI_FILE" ]]; then
    cat << 'SNI_EOF' > "$SNI_FILE"
gateway.icloud.com
swdist.apple.com
appldnld.apple.com
configuration.apple.com
SNI_EOF
fi

SERVER_IP=$(curl -4 -s --connect-timeout 3 icanhazip.com || curl -4 -s --connect-timeout 3 api.ipify.org || echo "YOUR_SERVER_IP")
XRAY_PORT=$(jq -r '.inbounds[0].port // 443' "$CONFIG_FILE")
XHTTP_PATH=$(jq -r '.inbounds[0].streamSettings.xhttpSettings.path // "/download"' "$CONFIG_FILE")

while true; do
    clear
    echo -e "${CYAN}================================================================${NC}"
    echo -e "${CYAN}            МАСТЕР СОЗДАНИЯ НОВОГО ПОЛЬЗОВАТЕЛЯ                 ${NC}"
    echo -e "${CYAN}================================================================${NC}"

    read -p "Введите имя пользователя (латиницей, например alex): " USER_NAME
    USER_NAME=$(echo "$USER_NAME" | tr -dc 'a-zA-Z0-9_-')

    if [[ -z "$USER_NAME" ]]; then
        echo -e "${RED}[ОШИБКА] Имя пользователя не может быть пустым.${NC}"
        sleep 1.5
        continue
    fi

    if jq -e --arg email "$USER_NAME" '.inbounds[0].settings.clients[] | select(.email == $email)' "$CONFIG_FILE" >/dev/null 2>&1; then
        echo -e "${RED}[ОШИБКА] Пользователь с именем '$USER_NAME' уже существует!${NC}"
        read -p "Нажмите Enter для повторного ввода..."
        continue
    fi

    echo -e "\n${BLUE}Настройка Cloudflare WARP:${NC}"
    echo -e "WARP скрывает реальный IP сервера и открывает ChatGPT/стриминги."
    echo -e "По умолчанию рекомендуется ${GREEN}НЕТ (N)${NC} для максимальной скорости."
    read -p "Включить WARP для '$USER_NAME'? [y/N] (по умолчанию N): " WARP_INPUT
    WARP_ENABLED=false
    if [[ "$WARP_INPUT" =~ ^[yYдД]$ ]]; then
        WARP_ENABLED=true
    fi

    echo -e "\n${BLUE}Выбор SNI маскировки:${NC}"
    mapfile -t SNI_LIST < "$SNI_FILE"
    for i in "${!SNI_LIST[@]}"; do
        echo -e " [$((i+1))] ${SNI_LIST[$i]}"
    done
    echo -e " [r] Случайный SNI из пула"
    read -p "Выберите номер SNI [1-${#SNI_LIST[@]} или r] (по умолчанию 1): " SNI_CHOICE

    SELECTED_SNI="${SNI_LIST[0]}"
    if [[ "$SNI_CHOICE" =~ ^[0-9]+$ ]] && (( SNI_CHOICE >= 1 && SNI_CHOICE <= ${#SNI_LIST[@]} )); then
        SELECTED_SNI="${SNI_LIST[$((SNI_CHOICE-1))]}"
    elif [[ "$SNI_CHOICE" =~ ^[rR]$ ]]; then
        RANDOM_IDX=$((RANDOM % ${#SNI_LIST[@]}))
        SELECTED_SNI="${SNI_LIST[$RANDOM_IDX]}"
    fi

    NEW_UUID=$(/usr/local/bin/xray uuid)

    CLIENT_OBJ=$(jq -n \
        --arg id "$NEW_UUID" \
        --arg email "$USER_NAME" \
        --arg sni "$SELECTED_SNI" \
        --argjson warp "$WARP_ENABLED" \
        '{id: $id, email: $email, flow: "", sni: $sni, warp: $warp}')

    TMP_CFG=$(mktemp)
    jq --argjson client "$CLIENT_OBJ" '.inbounds[0].settings.clients += [$client]' "$CONFIG_FILE" > "$TMP_CFG"

    if [[ "$WARP_ENABLED" = true ]]; then
        jq --arg email "$USER_NAME" '
            (.routing.rules[] | select(.outboundTag == "warp").user) += [$email] |
            (.routing.rules[] | select(.outboundTag == "warp").user) |= unique
        ' "$TMP_CFG" > "$TMP_CFG.2" && mv "$TMP_CFG.2" "$TMP_CFG"
    fi

    if /usr/local/bin/xray -test -config "$TMP_CFG" >/dev/null 2>&1; then
        mv "$TMP_CFG" "$CONFIG_FILE"
        systemctl restart xray
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] [INFO] [CLIENT] Создан пользователь '$USER_NAME' (UUID: $NEW_UUID, WARP: $WARP_ENABLED, SNI: $SELECTED_SNI)" >> "$LOG_FILE"
    else
        echo -e "${RED}[ОШИБКА] Сгенерированный конфиг не прошел валидацию Xray! Отмена.${NC}"
        rm -f "$TMP_CFG"
        read -p "Нажмите Enter для возврата..."
        break
    fi

    VLESS_URI="vless://${NEW_UUID}@${SERVER_IP}:${XRAY_PORT}?security=reality&type=xhttp&path=${XHTTP_PATH}&mode=packet-up&sni=${SELECTED_SNI}&fp=chrome&pbk=${PUBLIC_KEY}&sid=${SHORT_ID}#${USER_NAME}"

    clear
    echo -e "${GREEN}================================================================${NC}"
    echo -e "${GREEN}       ПОЛЬЗОВАТЕЛЬ '$USER_NAME' УСПЕШНО СОЗДАН!                ${NC}"
    echo -e "${GREEN}================================================================${NC}"
    echo -e "Имя:        ${CYAN}$USER_NAME${NC}"
    echo -e "UUID:       ${CYAN}$NEW_UUID${NC}"
    echo -e "Режим WARP: $(if [[ "$WARP_ENABLED" = true ]]; then echo -e "${GREEN}ВКЛЮЧЕН${NC}"; else echo -e "${YELLOW}ВЫКЛЮЧЕН (Direct)${NC}"; fi)"
    echo -e "Маскировка: ${CYAN}$SELECTED_SNI${NC}"
    echo -e "Транспорт:  ${CYAN}xHTTP (packet-up)${NC}"
    echo -e "${CYAN}----------------------------------------------------------------${NC}"
    echo -e "${YELLOW}Строка подключения (VLESS URI):${NC}"
    echo -e "${CYAN}${VLESS_URI}${NC}"
    echo -e "${CYAN}----------------------------------------------------------------${NC}"
    echo -e "${YELLOW}QR-код для быстрого подключения смартфона:${NC}\n"
    if command -v qrencode >/dev/null 2>&1; then
        qrencode -t ANSIUTF8 "${VLESS_URI}" || true
    fi
    echo -e "\n${CYAN}================================================================${NC}"

    read -p "Создать еще одного пользователя? [y/N]: " AGAIN
    if [[ ! "$AGAIN" =~ ^[yYдД]$ ]]; then
        break
    fi
done
